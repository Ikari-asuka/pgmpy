def print_slow(text, delay=0.04):
    for char in text:
        print(char, end='', flush=True)
        time.sleep(delay)
    print()

# ---------------------- 道具类 ----------------------
class Item:
    def __init__(self, name, desc, item_type, value):
        self.name = name
        self.desc = desc
        self.item_type = item_type
        self.value = value

    def use(self, player):
        if self.item_type == "heal":
            player.hp += self.value
            print_slow(f"💚 使用{self.name}，恢复 {self.value} 点生命！")
        elif self.item_type == "attack":
            player.attack += self.value
            print_slow(f"⚔️ 使用{self.name}，攻击 +{self.value}！")
        elif self.item_type == "defense":
            player.defense += self.value
            print_slow(f"🛡️ 使用{self.name}，防御 +{self.value}！")

    def __str__(self):
        return f"{self.name}：{self.desc}"

ITEM_DB = [
    Item("小型回血药", "恢复25点生命", "heal", 25),
    Item("大型回血药", "恢复60点生命", "heal", 60),
    Item("力量药剂", "临时增加8点攻击", "attack", 8),
    Item("铁盾", "临时增加5点防御", "defense", 5)
]

# ---------------------- 玩家类 ----------------------
class Player:
    def __init__(self, name):
        self.name = name
        self.hp = 150
        self.attack = 18
        self.defense = 8
        self.level = 1
        self.exp = 0
        self.gold = 30
        self.current_level = 1
        self.max_level = 5
        self.inventory = []

    def show_status(self):
        print(f"\n===== {self.name} 状态 =====")
        print(f"等级: {self.level} | 当前关卡: {self.current_level}/{self.max_level}")
        print(f"生命值: {self.hp}")
        print(f"攻击: {self.attack}")
        print(f"防御: {self.defense}")
        print(f"金币: {self.gold}")
        print(f"经验: {self.exp}/{self.level*15}")
        print("==========================\n")

    def show_inventory(self):
        print("\n🎒 背包：")
        if not self.inventory:
            print("空空如也...")
            return
        for i, item in enumerate(self.inventory):
            print(f"[{i+1}] {item}")

    def add_item(self, item):
        self.inventory.append(item)
        print_slow(f"✨ 获得道具：{item.name}")

    def use_item(self, index):
        if 0 <= index < len(self.inventory):
            item = self.inventory.pop(index)
            item.use(self)
        else:
            print("❌ 没有这个道具！")

    def level_up(self):
        need_exp = self.level * 15
        while self.exp >= need_exp:
            self.level += 1
            self.exp -= need_exp
            self.hp += 25
            self.attack += 5
            self.defense += 3
            print_slow(f"\n🎉 恭喜你升级了！现在是 {self.level} 级！")

    def level_clear_reward(self):
        reward_gold = self.current_level * 60
        reward_exp = self.current_level * 40
        self.gold += reward_gold
        self.exp += reward_exp
        print_slow(f"\n🏆 关卡{self.current_level}通关奖励！")
        print_slow(f"获得 {reward_gold} 金币 + {reward_exp} 经验！")
        self.level_up()

# ---------------------- 小怪类 ----------------------
class Enemy:
    def __init__(self, level):
        types = ["哥布林", "野狼", "骷髅兵", "小恶魔", "毒蜘蛛"]
        self.name = random.choice(types)
        self.hp = 25 + (level - 1) * 8 + random.randint(0, 15)
        self.attack = DIFF["monster_attack_base"] + (level-1)*DIFF["monster_attack_grow"] + random.randint(0,3)
        self.gold_drop = random.randint(8, 20)
        self.exp_drop = random.randint(10, 25)

        # 移动
        self.move_cd = DIFF["monster_move_cd"]
        self.move_prob = DIFF["monster_move_prob"]
        self.move_counter = 0

        # 攻击频率
        self.attack_cd = DIFF["monster_attack_cd"]
        self.cd_counter = 0
        self.attack_prob = DIFF["monster_attack_prob"]

        # 攻击范围
        self.attack_range = DIFF["monster_range"]
        self.distance = 3

    def try_move(self):
        if self.move_counter > 0:
            self.move_counter -= 1
            return False
        if random.random() < self.move_prob:
            self.move_counter = self.move_cd
            self.distance = max(0, self.distance - 1)
            return True
        return False

    def can_attack(self):
        return self.distance <= self.attack_range

    def try_attack(self):
        if self.cd_counter > 0:
            self.cd_counter -= 1
            return False
        if self.can_attack() and random.random() < self.attack_prob:
            self.cd_counter = self.attack_cd
            return True
        return False

    def drop_item(self):
        if random.random() < 0.6:
            return random.choice(ITEM_DB)
        return None

