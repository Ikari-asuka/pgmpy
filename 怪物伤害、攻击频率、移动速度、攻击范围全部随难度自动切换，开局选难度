# ---------------------- 战斗逻辑 ----------------------
def level_battle(player):
    current_level = player.current_level
    print_slow(f"\n===== 进入关卡 {current_level} =====")
    monster_count = current_level + 1

    for i in range(monster_count):
        if player.hp <= 0:
            break
        enemy = Enemy(current_level)
        print_slow(f"\n⚠️ 遭遇第{i+1}只小怪：{enemy.name}")

        while enemy.hp > 0 and player.hp > 0:
            print(f"\n你的HP：{player.hp}  |  {enemy.name} HP：{enemy.hp} | 距离：{enemy.distance}")
            action = input("1. 攻击  2. 逃跑：")
            if action == "1":
                damage = max(1, player.attack - enemy.hp // 10)
                enemy.hp -= damage
                print_slow(f"你对 {enemy.name} 造成了 {damage} 点伤害！")

                if enemy.hp > 0:
                    if enemy.try_move():
                        print_slow(f"👣 {enemy.name} 向你靠近！距离：{enemy.distance}")
                    if enemy.try_attack():
                        dmg = max(1, enemy.attack - player.defense)
                        player.hp -= dmg
                        if enemy.distance>0:
                            print_slow(f"🏹 {enemy.name}远程攻击，受到{dmg}点伤害！")
                        else:
                            print_slow(f"{enemy.name}近身攻击，受到{dmg}点伤害！")
            elif action == "2":
                print_slow("你逃跑了！")
                break
            else:
                print("输入错误！")

        if enemy.hp <= 0:
            print_slow(f"\n✅ 击败 {enemy.name}！")
            player.gold += enemy.gold_drop
            player.exp += enemy.exp_drop
            item = enemy.drop_item()
            if item:
                player.add_item(item)
            player.level_up()

    if player.hp > 0:
        boss = Boss(current_level)
        print_slow(f"\n🔥 BOSS【{boss.name}】登场！技能：{boss.skill}")
        while boss.hp > 0 and player.hp > 0:
            print(f"\n你的HP：{player.hp}  |  BOSS HP：{boss.hp} | 距离：{boss.distance}")
            action = input("1. 攻击  2. 逃跑：")
            if action == "1":
                dmg = max(1, player.attack - boss.hp // 15)
                boss.hp -= dmg
                print_slow(f"你造成 {dmg} 伤害！")

                if boss.hp > 0:
                    if boss.try_move():
                        print_slow(f"👣 BOSS向你逼近！距离：{boss.distance}")
                    if boss.try_attack():
                        if random.random() < 0.2:
                            bd = max(1, boss.attack * boss.skill_rate - player.defense)
                            player.hp -= bd
                            print_slow(f"⚠️ BOSS释放技能！受到{bd}点高额伤害！")
                        else:
                            bd = max(1, boss.attack - player.defense)
                            player.hp -= bd
                            if boss.distance>0:
                                print_slow(f"🏹 BOSS远程打击，受到{bd}点伤害！")
                            else:
                                print_slow(f"BOSS近身猛攻，受到{bd}点伤害！")
            elif action == "2":
                if random.random() < 0.3:
                    print_slow("逃跑失败！被重击！")
                    player.hp -= max(1, boss.attack*1.2 - player.defense)
                else:
                    print_slow("逃跑成功！")
                    break
        if boss.hp <= 0:
            print_slow(f"\n🏆 成功击败BOSS【{boss.name}】！")
            player.gold += boss.gold_drop
            player.exp += boss.exp_drop
            player.level_clear_reward()
            if player.current_level < player.max_level:
                player.current_level += 1
                print_slow(f"\n🚪 成功解锁下一关卡！")
            else:
                print_slow("\n🎉 恭喜通关全部关卡，成为最强冒险者！")
                return "win"
    if player.hp <= 0:
        print_slow("\n💀 你体力耗尽，冒险失败...")
        return "game_over"

# ---------------------- 难度选择菜单 ----------------------
def choose_difficulty():
    global DIFF
    print("="*30)
    print("        选择游戏难度")
    print("="*30)
    print("1. 简单模式   — 怪物伤害低、移动慢、只能贴身攻击")
    print("2. 普通模式   — 标准难度，体验完整游戏")
    print("3. 困难模式   — 怪物高伤、高速、远程先手攻击")
    print("="*30)
    while True:
        c = input("请输入难度序号(1/2/3)：")
        if c == "1":
            DIFF = EASY
            print_slow("已进入【简单模式】游玩愉快~")
            break
        elif c == "2":
            DIFF = NORMAL
            print_slow("已进入【普通模式】准备冒险！")
            break
        elif c == "3":
            DIFF = HARD
            print_slow("已进入【困难模式】小心应战！")
            break
        else:
            print("输入错误，请重新选择！")

# ---------------------- 主游戏入口 ----------------------
def game():
    choose_difficulty()
    print_slow("\n===== 文字冒险闯关世界 =====")
    name = input("请输入你的冒险者名字：")
    player = Player(name)
    print_slow(f"\n欢迎你，勇敢的{player.name}，冒险之旅正式开启！")

    while True:
        print(f"\n===== 主菜单 | 当前关卡：{player.current_level}/{player.max_level} =====")
        print("1. 挑战当前关卡")
        print("2. 查看自身状态")
        print("3. 打开背包查看道具")
        print("4. 使用背包道具")
        print("5. 退出冒险游戏")
        opt = input("请选择操作：")
        if opt == "1":
            res = level_battle(player)
            if res in ("win","game_over"):
                break
        elif opt == "2":
            player.show_status()
        elif opt == "3":
            player.show_inventory()
        elif opt == "4":
            player.show_inventory()
            if player.inventory:
                num = input("输入道具编号使用：")
                if num.isdigit():
                    player.use_item(int(num)-1)
        elif opt == "5":
            print_slow("👋 旅途结束，下次再见！")
            break
        else:
            print("无效输入，请重新选择！")

if __name__ == "__main__":
    game()
